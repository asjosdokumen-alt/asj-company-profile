---
/**
 * ClosingBand.astro — the closing call to action, above the footer.
 *
 * REDESIGNED 2026-09-20: premium gradient CTA band with accent glow.
 * The old version used a flat Card with the `band` radius. This version
 * uses a gradient background from the hero palette for visual continuity,
 * making the CTA feel like a bookend to the hero rather than a sidebar.
 *
 * WHY THE CTA IS NOW A PLAIN ANCHOR — CHANGED 2026-09-30
 * -----------------------------------------------------
 * It used to be a `<button>` that dispatched `asj-kandidat-register`, an event
 * the App island listened for to open the registration modal. That modal is
 * gone (see `src/components/App.tsx`): it posted to a Netlify Function this
 * repo does not have, so the button opened a form that failed on every submit —
 * and once the modal was removed, the dispatch had no listener at all, which is
 * strictly worse than the broken version because nothing at all happens.
 *
 * It now points at `#kontak`, the page's own conversion surface, which carries
 * the phone number, the three channel QR codes and the working form. A CTA that
 * scrolls somewhere real beats a CTA that opens nothing.
 *
 * i18n: every string is a key plus a visible fallback, the repo's standard
 * pattern, so a crawler and a no-JS visitor see real text.
 */
import Section from './Section.astro';
import Icon from '../ui/Icon';
---

<Section id="daftar" enter="focus">
  <div class="hero-gradient rounded-band border border-white/10 overflow-hidden shadow-2xl">
    <div class="relative z-10 text-center flex flex-col items-center gap-6 p-8 md:p-14">
      <h2 data-lang="profile.cta_title" class="text-section font-black text-white">
        Siap memulai perjalanan ke Jepang?
      </h2>
      <p data-lang="profile.cta_sub" class="max-w-[52ch] text-body-sm text-slate-200">
        Lihat lowongan yang tersedia atau daftar sebagai pelamar hari ini.
      </p>
      <div class="flex flex-wrap justify-center gap-3 mt-2">
        {/* NO "Lihat Lowongan" CTA HERE. Owner ruling 2026-09-24: `/` is a
            company profile for MoU/business partners, not a job board, so this
            band does not link to a vacancy list. */}
        <a
          href="#kontak"
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-pill bg-white/10 hover:bg-white/20 border border-white/20 text-white font-bold text-sm backdrop-blur-sm transition active:translate-y-px"
        >
          <Icon name="user-plus" />
          <span data-lang="profile.cta_secondary">Daftar Pelamar</span>
        </a>
      </div>
    </div>
  </div>
</Section>
